# ── Apollo Client / GraphQL ───────────────────────────────────────────
# HTTP endpoint of the Django Strawberry GraphQL API.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql/

# WebSocket endpoint used for GraphQL subscriptions (graphql-ws) and the
# live event monitor. Leave unset to disable real-time features — the UI
# degrades gracefully and reports an "Unavailable" connection state.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/graphql/

# Contract pre-filled on the /monitor page.
NEXT_PUBLIC_DEFAULT_CONTRACT_ID=CCAA

# Production example:
# NEXT_PUBLIC_GRAPHQL_URL=https://api.soroscan.io/graphql/
# NEXT_PUBLIC_WS_URL=wss://api.soroscan.io/graphql/
